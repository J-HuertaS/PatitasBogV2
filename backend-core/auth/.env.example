# ============================================

# Example Environment Configuration (.env.example)

# Copy this file to .env and fill with real values

# ============================================

# Database URL

DATABASE_URL=postgresql://username:password@host:port/database

# JWT Secret

JWT_SECRET=your_super_secret_jwt_key_here

# Server Port

PORT=5000

# Environment Mode

FLASK_ENV=development

# ============================================

# Email Configuration (SMTP)

# ============================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=[your_email@gmail.com](mailto:your_email@gmail.com)
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=[your_email@gmail.com](mailto:your_email@gmail.com)

# ============================================

# Supabase Storage Configuration

# ============================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_BUCKET=avatars
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================

# Frontend URL (for password reset links)

# ============================================

FRONTEND_URL=http://localhost:3000
